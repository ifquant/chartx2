{
  "name": "chartx2-workspace",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10",
  "scripts": {
    "check": "pnpm -r check",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:unit": "pnpm --filter @chartx2/library test:unit && pnpm --filter @chartx2/example-tauri-svelte test:unit",
    "test:visual": "pnpm --filter @chartx2/example-tauri-svelte test:visual",
    "release:local": "node ./scripts/pack-chartx2-local-release.mjs",
    "release:local:verify": "node ./scripts/verify-chartx2-local-release-consumer.mjs",
    "release:local:check": "node ./scripts/check-chartx2-local-release.mjs"
  }
}
