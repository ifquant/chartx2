{
  "name": "@chartx2/library",
  "version": "0.2.0",
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./workbench-drawing-inspector": {
      "types": "./dist/workbench-drawing-inspector.d.ts",
      "svelte": "./dist/workbench-drawing-inspector.js",
      "default": "./dist/workbench-drawing-inspector.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "build": "svelte-kit sync && svelte-package --tsconfig ./tsconfig.package.json && node ./scripts/sync-package-types.mjs",
    "test": "pnpm test:unit",
    "test:unit": "pnpm build && vitest run tests/unit --passWithNoTests"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/package": "^2.3.7",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/node": "^22",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^4.1.2"
  }
}
